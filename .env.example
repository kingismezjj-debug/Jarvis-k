# Jarvis-K intentionally does not load provider credentials from .env.
# Configure Xunfei RTASR through the Electron voice service settings window.
#
# Real provider acceptance is opt-in after credentials are saved locally:
# JARVIS_K_REAL_PROVIDER_ACCEPTANCE=1
#
# Fixture inference is test-only and never downloads or loads real models:
# JARVIS_K_ENABLE_FIXTURE_INFERENCE=1
#
# Chat Answer product-loop fixture is default-off and does not use credentials,
# network, Memory, or model runtime:
# JARVIS_K_ENABLE_FIXTURE_CHAT_ANSWER=1
#
# Optional safe browser alias. When set to a fixed HTTPS URL, voice/text
# commands that resolve to "IZYtoken admin" may open only this configured URL.
# Do not include credentials, tokens, signed URLs, or unsafe query parameters.
# JARVIS_K_IZYTOKEN_ADMIN_URL=https://example.com/admin
#
# Brain fast router is default-off. Point this at an approved local
# intent_router model such as a future Qwen3-0.6B adapter after model
# lifecycle approval and artifact pinning.
# JARVIS_K_BRAIN_ROUTER_MODEL_ID=approved/local-intent-router
# JARVIS_K_ENABLE_BRAIN_ROUTER=1
#
# Stage 2 Qwen3-0.6B fast-router adapter remains unavailable until a
# separate real runtime/cache acceptance approves a generation port.
# JARVIS_K_BRAIN_ROUTER_MODEL_ID=Qwen/Qwen3-0.6B
# JARVIS_K_ENABLE_QWEN_FAST_ROUTER=1
